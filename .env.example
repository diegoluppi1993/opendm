# OpenDM production environment example
#
# REQUIRED values are intentionally placeholders: replace every one before
# starting Docker Compose. Never commit the populated .env file.
# Generate independent random secrets with:
#   openssl rand -base64 32     # NEXTAUTH_SECRET, CRON_SECRET, WEBHOOK_VERIFY_TOKEN
#   openssl rand -hex 32        # ENCRYPTION_KEY (exactly 64 hexadecimal characters)
#   openssl rand -hex 32        # POSTGRES_PASSWORD (URL-safe hexadecimal value)

# Application (REQUIRED)
NEXTAUTH_URL=https://opendm.example.com
NEXTAUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
CRON_SECRET=replace-with-output-of-openssl-rand-base64-32
ENCRYPTION_KEY=replace-with-output-of-openssl-rand-hex-32

# Docker Compose database (REQUIRED: POSTGRES_PASSWORD; names have safe defaults)
POSTGRES_DB=opendm
POSTGRES_USER=opendm
POSTGRES_PASSWORD=replace-with-output-of-openssl-rand-hex-32

# Used only when running app or Prisma commands outside Docker Compose.
# Keep the credentials in sync with the POSTGRES_* values above.
DATABASE_URL=postgresql://opendm:replace-with-postgres-password@localhost:5432/opendm
REDIS_URL=redis://localhost:6379

# Email magic links (configure Resend OR EMAIL_SERVER)
EMAIL_FROM=OpenDM <login@example.com>
RESEND_API_KEY=replace-with-your-resend-api-key

# Optional SMTP alternative. When set, EMAIL_SERVER takes precedence and
# RESEND_API_KEY is not needed. URL-encode credentials (@ becomes %40).
# EMAIL_SERVER=smtps://login%40example.com:replace-with-password@mail.example.com:465
EMAIL_SERVER=

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=replace-with-your-instagram-app-id
INSTAGRAM_APP_SECRET=replace-with-your-instagram-app-secret
FACEBOOK_APP_SECRET=replace-with-your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-output-of-openssl-rand-base64-32
